# Cloudflare Pages / Workers Environment Variables Example
# In production, set these via Cloudflare Dashboard or Wrangler Secrets.
# For local development, copy this file to `.dev.vars` for Wrangler.

# Google Gemini API Key for AI reflection and chat features
GEMINI_API_KEY="your_gemini_api_key_here"

# --------------------------------------------------------
# The following variables are already set in wrangler.jsonc
# but can be overridden locally in .dev.vars if needed:
# --------------------------------------------------------
# CAMP_NAME="VLC 2027"
# CAMP_THEME="Arise & Shine (Isaiah 60:1)"
# TARGET_CAPACITY="600"
# EMAIL_FROM="VLC 2027 Camp Desk <noreply@pcciministries.com>"
# BASE_URL="http://localhost:8788"
