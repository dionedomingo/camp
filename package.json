{
  "name": "summer-camp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:all": "npm run build && (npm run cf:functions & cf_pid=$!; trap 'kill $cf_pid 2>/dev/null' EXIT INT TERM; npm run dev)",
    "cf:dev": "npx wrangler pages dev dist",
    "cf:functions": "npx wrangler pages dev dist --port 8788",
    "pages:dev": "wrangler pages dev ./dist",
    "d1:init": "wrangler d1 execute vlc2027-camp-db --local --file=./d1/schema.sql && wrangler d1 execute vlc2027-camp-db --local --file=./d1/seed.sql",
    "d1:reset": "rm -rf .wrangler/state/v3/d1 && npm run d1:init",
    "d1:remote": "wrangler d1 execute vlc2027-camp-db --remote",
    "d1:remote:file": "wrangler d1 execute vlc2027-camp-db --remote -y --file",
    "deploy": "npm run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}